rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signedIn() { return request.auth != null; }
   function staff() { return signedIn() && request.auth.token.role in ['admin','instructor']; }
   function admin() { return signedIn() && request.auth.token.role == 'admin'; }
   match /courses/{courseId} {
     allow read: if resource.data.published == true || staff();
     allow write: if false;
     match /lessons/{lessonId} {
       allow read: if (get(/databases/$(database)/documents/courses/$(courseId)).data.published == true) || staff();
       allow write: if false;
     }
     match /quizzes/{quizId} { allow read: if signedIn() && (get(/databases/$(database)/documents/courses/$(courseId)).data.published == true || staff()); allow write: if false; }
     match /answerKeys/{quizId} { allow read, write: if false; }
   }
   match /users/{uid} {
     allow read: if signedIn() && (request.auth.uid == uid || admin());
     allow write: if false;
     match /enrollments/{courseId} {
       allow read: if signedIn() && (request.auth.uid == uid || admin());
       allow write: if false;
     }
   }
   match /learningProfiles/{uid} {
     allow read: if signedIn() && (request.auth.uid == uid || admin());
     allow write: if false;
     match /completions/{id} {allow read: if signedIn() && (request.auth.uid == uid || admin());allow write: if false;}
   }
   match /submissions/{id} {
     allow read: if signedIn() && (resource.data.uid == request.auth.uid || staff());
     allow write: if false;
   }
   match /{collection}/{id} {
     allow read: if collection in ['quests','practice','labs','portfolios','communities','careers','resources','challenges','equipment','experiences','opportunities','sessions'] && (resource.data.published == true || staff());
     allow write: if false;
   }
   match /labJobs/{id} { allow read, write: if false; }
   match /auditEvents/{id} { allow read, write: if false; }
   match /moderationQueue/{id} { allow read, write: if false; }
   match /equipment/{equipmentId}/slots/{slotId} {allow read: if signedIn(); allow write: if false;}
   match /users/{uid}/syncOperations/{id} {allow read,write: if false;}
   match /users/{uid}/lessonReads/{id} {allow read: if signedIn() && (request.auth.uid == uid || admin());allow write: if false;}
   match /users/{uid}/bookings/{id} {allow read: if signedIn() && (request.auth.uid == uid || admin());allow write: if false;}
   match /certificates/{id} { allow read, write: if false; }
   match /aiUsage/{id} { allow read, write: if false; }
   match /{document=**} { allow read, write: if false; }
 }
}
